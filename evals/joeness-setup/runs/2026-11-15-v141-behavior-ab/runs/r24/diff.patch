import { readFileSync } from 'node:fs';
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
// B1: mobile (360) button min height >= 44px. Measures the layout value only, not rendered output.
let bad = 0;
for (const [rule, width, min] of [['B1', '360', 44]]) {
  const got = layout.button?.min_height?.[width];
  const ok = typeof got === 'number' && got >= min;
  console.log(rule + ' button min_height@' + width + ' = ' + got + (ok ? ' ok' : ' FAIL') + ' (>= ' + min + ')');
  if (!ok) bad += 1;
}
process.exitCode = bad ? 1 : 0;
