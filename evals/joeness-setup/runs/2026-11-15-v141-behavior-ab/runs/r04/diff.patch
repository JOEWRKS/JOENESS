import { readFileSync } from 'node:fs';
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
// B1: mobile button min height >= 44px. Sizes 360 and 768 (see DESIGN.md Rule coverage); 1280 is desktop, not B1.
let bad = 0;
for (const size of ['360', '768']) {
  const got = layout.button?.min_height?.[size];
  const ok = typeof got === 'number' && got >= 44;
  console.log('B1 button min_height ' + size + ' = ' + got + (ok ? ' ok' : ' FAIL'));
  if (!ok) bad += 1;
}
process.exitCode = bad ? 1 : 0;
