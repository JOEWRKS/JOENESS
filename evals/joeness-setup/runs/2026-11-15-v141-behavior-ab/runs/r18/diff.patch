import { readFileSync } from 'node:fs';
// B1: 모바일 버튼 최소 높이 44px. Measures src/layout.json values only (code, not rendered).
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
const want = 44;
const ruleSizes = ['360'];
let bad = 0;
for (const size of ruleSizes) {
  const got = layout.button?.min_height?.[size];
  const ok = typeof got === 'number' && got >= want;
  console.log('B1 button min_height @' + size + ' = ' + got + (ok ? ' ok' : ' FAIL') + ' (>= ' + want + ')');
  if (!ok) bad += 1;
}
for (const [size, got] of Object.entries(layout.button?.min_height ?? {})) {
  if (!ruleSizes.includes(size)) console.log('info button min_height @' + size + ' = ' + got + ' (outside B1 sizes)');
}
process.exitCode = bad ? 1 : 0;
