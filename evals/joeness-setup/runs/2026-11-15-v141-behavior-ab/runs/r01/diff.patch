import { readFileSync } from 'node:fs';
// B1: mobile button min height >= 44px. Reads declared values in src/layout.json (code, not rendered).
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
const MOBILE_SIZES = ['360'];
const MIN = 44;
let bad = 0;
for (const size of MOBILE_SIZES) {
  const got = layout.button?.min_height?.[size];
  const ok = typeof got === 'number' && got >= MIN;
  console.log('B1 button min_height ' + size + ' = ' + got + (ok ? ' ok' : ' FAIL') + ' (>= ' + MIN + ')');
  if (!ok) bad += 1;
}
process.exitCode = bad ? 1 : 0;
