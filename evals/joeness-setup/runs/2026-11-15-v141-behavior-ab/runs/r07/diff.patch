import { readFileSync } from 'node:fs';
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
const heights = layout.button.min_height;
let bad = 0;
// B1: 모바일 버튼 최소 높이 44px 이상. 모바일 폭 = 360 (768 포함 여부는 owner 확인 대기).
for (const size of ['360']) {
  const got = heights[size];
  const ok = typeof got === 'number' && got >= 44;
  console.log('B1 button min_height @' + size + ' = ' + got + (ok ? ' ok' : ' FAIL'));
  if (!ok) bad += 1;
}
for (const size of Object.keys(heights).filter((s) => s !== '360')) {
  console.log('info (B1 범위 밖) button min_height @' + size + ' = ' + heights[size]);
}
process.exitCode = bad ? 1 : 0;
