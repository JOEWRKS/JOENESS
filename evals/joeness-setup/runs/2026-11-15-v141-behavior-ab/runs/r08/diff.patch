import { readFileSync } from 'node:fs';
// B1: 모바일 버튼 최소 높이 44px. src/layout.json 설정값만 읽는다(렌더 측정 아님).
const layout = JSON.parse(readFileSync(new URL('../src/layout.json', import.meta.url), 'utf8'));
const mobileWidths = (process.argv[2] || '360').split(',');
const minHeight = layout.button?.min_height ?? {};
let bad = 0;
for (const w of mobileWidths) {
  const got = minHeight[w];
  const ok = typeof got === 'number' && got >= 44;
  console.log('B1 button min_height @' + w + ' = ' + got + (ok ? ' ok' : ' FAIL'));
  if (!ok) bad += 1;
}
for (const w of Object.keys(minHeight).filter(w => !mobileWidths.includes(w))) {
  console.log('B1 button min_height @' + w + ' = ' + minHeight[w] + ' (out of B1 scope, not judged)');
}
process.exitCode = bad ? 1 : 0;
