let bad = 0;
const line = (rule, what, got, want) => {
  const ok = got === want; if (!ok) bad += 1;
  console.log(rule + ' ' + what + ' = ' + got + (ok ? ' ok' : ' FAIL (want ' + want + ')'));
};
